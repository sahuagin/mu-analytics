#!/bin/sh
# ai-sessions-sync — relay live claude-code + mu session logs into the
# consolidated ~/ai-sessions archive that mu-analytics reads. (cpdup edition)
#
# Why cpdup, not rsync (2026-10-15): rsync -aW --no-i-r stats the ENTIRE tree
# into memory before moving a byte; on the 9.5G archive that stat storm pushed
# load past core count while every core sat idle, and runs were dying mid-copy
# (24,307 ERR vs 143,222 ok in the log). cpdup walks per-directory with flat
# memory and compares by size+mtime only — same quick-check semantics the old
# rsync flags already used.
#
# cpdup flags:
#   -o  NO deletes — the archive RETAINS files a source rotates out. cpdup
#       mirrors by default; -o is load-bearing for that contract. Do not drop.
#   -q  quiet (we print our own ok:/ERR lines)
#   -l  line-buffered output
# A pidfile prevents overlap; nice(10) keeps it background work.
#
# Usage:  ai-sessions-sync
#   AI_SESSIONS_SYNC_CONF=...    config file (default ~/.config/ai-sessions-sync.conf)
#   AI_SESSIONS_SYNC_CPDUP=...   cpdup binary (default: on PATH, else /usr/local/bin/cpdup)
set -u

conf="${AI_SESSIONS_SYNC_CONF:-$HOME/.config/ai-sessions-sync.conf}"
cpdup_bin="${AI_SESSIONS_SYNC_CPDUP:-$(command -v cpdup || echo /usr/local/bin/cpdup)}"
ts() { date "+%Y-%m-%d %H:%M:%S"; }

[ -f "$conf" ]     || { echo "[$(ts)] ai-sessions-sync: no config at $conf" >&2; exit 1; }
[ -x "$cpdup_bin" ] || { echo "[$(ts)] ai-sessions-sync: no cpdup at $cpdup_bin" >&2; exit 1; }


pidfile="${TMPDIR:-/tmp}/ai-sessions-sync.pid"
if [ -f "$pidfile" ]; then
  oldpid=$(cat "$pidfile" 2>/dev/null || true)
  if [ -n "${oldpid:-}" ] && kill -0 "$oldpid" 2>/dev/null; then
    echo "[$(ts)] ai-sessions-sync: previous run still active (pid $oldpid) — skipping"
    exit 0
  fi
fi
echo $$ > "$pidfile"
trap "rm -f $pidfile" EXIT

n_ok=0; n_err=0; n_skip=0
while IFS="|" read -r src dst; do
  case "$src" in ""|\#*) continue ;; esac
  src=$(printf "%s" "$src" | sed "s/[[:space:]]*$//")
  dst=$(printf "%s" "$dst" | sed "s/^[[:space:]]*//;s/[[:space:]]*$//")
  if [ -z "$dst" ]; then
    echo "  ERR (no dest): $src"; n_err=$((n_err + 1)); continue
  fi
  if [ ! -e "$src" ]; then
    echo "  skip (source missing): $src"; n_skip=$((n_skip + 1)); continue
  fi
  start=$(date +%s)
  if [ -d "$src" ]; then
    mkdir -p "$dst"
    if nice -n 10 "$cpdup_bin" -o -q -l "$src" "$dst"; then
      echo "  ok ($(($(date +%s) - start))s): $src/ -> $dst/"; n_ok=$((n_ok + 1))
    else
      echo "  ERR (cpdup $?): $src/ -> $dst/"; n_err=$((n_err + 1)); n_rc=1
    fi
  else
    mkdir -p "$(dirname "$dst")"
    if nice -n 10 "$cpdup_bin" -o -q -l "$src" "$dst"; then
      echo "  ok ($(($(date +%s) - start))s): $src -> $dst"; n_ok=$((n_ok + 1))
    else
      echo "  ERR (cpdup $?): $src -> $dst"; n_err=$((n_err + 1))
    fi
  fi
done < "$conf"
echo "[$(ts)] ai-sessions-sync: ok=$n_ok err=$n_err skip=$n_skip"
[ "${n_err:-0}" -eq 0 ] || exit 1
exit 0
